generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DailyLogStatus {
  EMPTY
  DRAFT
  SUBMITTED
  ANALYZED
  MISSING
  SKIPPED
}

enum TaskImportance {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  DONE
  NOT_DONE
  POSTPONED
  CANCELLED
}

enum CalendarEventType {
  EXAM
  INTERVIEW
  DEADLINE
  ADMIN
  SOCIAL
  TRAINING
  RECOVERY
  TRAVEL
  PERSONAL
}

enum CalendarImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ObjectiveKind {
  OBJECTIVE
  PROJECT
  MILESTONE
}

enum ObjectiveHorizon {
  YEAR
  QUARTER
  MONTH
  WEEK
}

enum ObjectiveStatus {
  PLANNED
  ACTIVE
  ON_TRACK
  AT_RISK
  PAUSED
  DONE
}

enum ObjectivePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WeeklyPlanCategory {
  WORK
  STUDY
  SPORT
  REST
  ADMIN
  PERSONAL
  SOCIAL
  TRAVEL
}

enum TimeAllocationPeriod {
  WEEK
  MONTH
}

model TaskCapture {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String? @unique
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title String
  @@index([userId])
}

model User {
  taskCaptures TaskCapture[]
  performanceWeeks PerformanceWeek[]
  id            String          @id @default(cuid())
  label         String          @default("Local user")
  calorieTarget Int             @default(2200)
  defaultSleepDelayMin Int      @default(20)
  dailyLogs     DailyLog[]
  tasks         Task[]
  taskTemplates TaskTemplate[]
  events        CalendarEvent[]
  timeCategories TimeAllocationCategory[]
  timeAllocations DailyTimeAllocation[]
  planningContexts DailyPlanningContext[]
  periodicTimeAllocations PeriodicTimeAllocation[]
  periodPlanningContexts TimeAllocationPeriodContext[]
  habits       Habit[]
  habitTemplates HabitTemplate[]
  habitCheckins HabitCheckin[]
  routineBlocks RoutineBlock[]
  objectives    Objective[]
  weeklyPlanBlocks WeeklyPlanBlock[]
  weeklyReports WeeklyReport[]
  companies     Company[]
  tags          Tag[]
  thinkingNotes ThinkingNote[]
  emotionalReviews EmotionalReview[]
  aiProviders   AiProvider[]
  weeklyRecaps  WeeklyRecap[]
  courses       Course[]
  courseDeadlines CourseDeadline[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model EmotionalReview {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekId          String
  weekStart       DateTime @db.Date
  emotions        Json
  factors         String[] @default([])
  stressLevel     Int      @default(0)
  triggers        String[] @default([])
  mentalSignals   String[] @default([])
  physicalSignals String[] @default([])
  whatHelped      String[] @default([])
  nextWeekAction  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, weekId])
  @@index([userId, weekStart])
}

model Company {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String    @default("#8da2fb")
  tasks     Task[]
  events    CalendarEvent[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Tag {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String         @default("#57c59a")
  tasks     TaskTag[]
  notes     ThinkingNoteTag[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model TaskTag {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model ThinkingNote {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  content    String
  reminderAt DateTime?
  tags       ThinkingNoteTag[]
  tasks      ThinkingNoteTask[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([userId, reminderAt])
}

model ThinkingNoteTag {
  noteId String
  note   ThinkingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model ThinkingNoteTask {
  noteId String
  note   ThinkingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  taskId String
  task   Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([noteId, taskId])
  @@index([taskId])
}

model DailyLog {
  id                     String         @id @default(cuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                   DateTime       @db.Date
  status                 DailyLogStatus @default(EMPTY)
  energy                 Int?
  productivity           Int?
  startFriction          Int?
  calorieTarget          Int?
  caloriePercent         Int?
  trainingDone           Boolean?
  mentalFatigue          Int?
  physicalFatigue        Int?
  focusQuality           Int?
  workTimeMinutes        Int?
  distractionTimeMinutes Int?
  avoidedImportantTask   Boolean?
  mainBlocker            String?
  improvementTomorrow    String?
  wins                   String[]       @default([])
  topImprovements        String[]       @default([])
  blockers               String[]       @default([])
  tomorrowPriorities     String[]       @default([])
  tags                   String[]       @default([])
  customFields           Json?
  sleepIntentClickedAt   DateTime?
  estimatedSleepDelayMin Int?
  estimatedSleepStart    DateTime?
  textSummary            String?
  voiceTranscript        String?
  executionScore         Int?
  stateScore             Int?
  riskScore              Int?
  riskDelta              Int?
  riskAcceleration       Int?
  regime                 String?
  regimeConfidence       Int?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  submittedAt            DateTime?

  @@unique([userId, date])
  @@index([userId, date])
}

model Task {
  capture TaskCapture?
  workSessions WeeklyPlanBlock[]
  planning TaskPlan?
  completedAt       DateTime?
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectiveId       String?
  objective         Objective?     @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title             String
  isDay             Boolean        @default(false)
  description       String?
  date              DateTime?      @db.Date
  startTime         String?
  endTime           String?
  importance        TaskImportance @default(MEDIUM)
  productive        Boolean        @default(true)
  estimatedMinutes  Int            @default(0)
  completionPercent Int            @default(0)
  status            TaskStatus     @default(PLANNED)
  notDoneReason     String?
  sortOrder         Int            @default(0)
  tags              TaskTag[]
  thinkingNotes     ThinkingNoteTask[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId, date])
  @@index([userId, objectiveId])
  @@index([userId, companyId])
  @@index([userId, sortOrder])
}

model TaskTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  fields    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model TimeAllocationCategory {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  objective      String?
  targetWeight   Int                   @default(0)
  expectedReturn Int                   @default(50)
  risk           Int                   @default(50)
  beta           Float                 @default(1)
  color          String                @default("#22d3ee")
  active         Boolean               @default(true)
  allocations    DailyTimeAllocation[]
  periodicAllocations PeriodicTimeAllocation[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId, active])
}

model TimeAllocationPeriodContext {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  period        TimeAllocationPeriod
  startDate     DateTime             @db.Date
  budgetMinutes Int
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([userId, period, startDate])
  @@index([userId, startDate])
}

model PeriodicTimeAllocation {
  id                   String                 @id @default(cuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId           String
  category             TimeAllocationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  period               TimeAllocationPeriod
  startDate            DateTime               @db.Date
  plannedMinutes       Int                    @default(0)
  plannedMinutesManual Boolean                @default(false)
  note                 String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([userId, categoryId, period, startDate])
  @@index([userId, period, startDate])
}

model DailyTimeAllocation {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String
  category       TimeAllocationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  date           DateTime               @db.Date
  plannedMinutes Int                    @default(0)
  plannedMinutesManual Boolean          @default(false)
  actualMinutes  Int                    @default(0)
  note           String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, categoryId, date])
  @@index([userId, date])
}

model DailyPlanningContext {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  dayBudgetMinutes Int      @default(720)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Habit {
  id                     String         @id @default(cuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  category               String         @default("routine")
  description            String?
  targetTime             String?
  defaultExpectedMinutes Int            @default(0)
  recurrenceDays         Int[]          @default([1, 2, 3, 4, 5, 6, 7])
  timeBlockEnabled       Boolean        @default(false)
  sortOrder              Int            @default(0)
  active                 Boolean        @default(true)
  source                 String         @default("manual")
  checkins               HabitCheckin[]
  routineBlocks          RoutineBlock[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([userId, active])
}

model HabitTemplate {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  category               String   @default("routine")
  description            String?
  targetTime             String?
  defaultExpectedMinutes Int      @default(0)
  recurrenceDays         Int[]    @default([1, 2, 3, 4, 5, 6, 7])
  timeBlockEnabled       Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId, createdAt])
}

model HabitCheckin {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId       String
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  status        String   @default("planned")
  actualMinutes Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, habitId, date])
  @@index([userId, date])
}

model RoutineBlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  dayType   String   @default("school_day")
  recurrenceDays Int[] @default([1, 2, 3, 4, 5, 6, 7])
  label     String
  startTime String
  endTime   String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dayType, active])
}

model CalendarEvent {
  id                      String            @id @default(cuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId               String?
  company                 Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title                   String
  type                    CalendarEventType @default(PERSONAL)
  start                   DateTime
  end                     DateTime
  impact                  CalendarImpact    @default(MEDIUM)
  expectedStress          Int               @default(50)
  expectedPreparationLoad Int               @default(50)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([userId, start])
  @@index([userId, companyId])
}

model WeeklyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekId    String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekId])
}

model Objective {
  planning ObjectivePlan?
  progressEntries ObjectiveProgressEntry[]
  completedAt DateTime?
  completionDeadline DateTime? @db.Date
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Objective?         @relation("ObjectiveTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Objective[]        @relation("ObjectiveTree")
  title       String
  summary     String?
  nextAction  String?
  kind        ObjectiveKind      @default(OBJECTIVE)
  horizon     ObjectiveHorizon
  status      ObjectiveStatus    @default(PLANNED)
  priority    ObjectivePriority  @default(MEDIUM)
  targetDate  DateTime?          @db.Date
  weekId      String?
  color       String             @default("#8da2fb")
  sortOrder   Int                @default(0)
  archived    Boolean            @default(false)
  tasks       Task[]
  weeklyBlocks WeeklyPlanBlock[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, archived, horizon])
  @@index([userId, weekId])
  @@index([parentId])
}

model WeeklyPlanBlock {
  taskId String?
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recovery BlockRecovery?
  actualMinutes Int?
  executionStatus String @default("planned")
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectiveId     String?
  objective       Objective?         @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  title           String
  category        WeeklyPlanCategory @default(WORK)
  date            DateTime           @db.Date
  startTime       String?
  endTime         String?
  durationMinutes Int                @default(60)
  flexible        Boolean            @default(false)
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, date])
  @@index([userId, objectiveId])
  @@unique([taskId, date])
}

model PerformanceWeek {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  targetMinutes Int @default(2400)

  @@id([userId, weekStart])
}

model ObjectivePlan {
  objectiveId String @id
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  effortMinutes Int @default(0)
  impact Int @default(50)
  manualProgress Int?
  ignoredUntil DateTime? @db.Date
}

model ObjectiveProgressEntry {
  objectiveId String
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  progress Int
  source String @default("execution")
  @@id([objectiveId, date])
}

model TaskPlan {
  taskId String @id
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  optimisticMinutes Int
  likelyMinutes Int
  pessimisticMinutes Int
  predecessorIds String[] @default([])
}

model BlockRecovery {
  blockId String @id
  block WeeklyPlanBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  action String
  replacementId String?
  createdAt DateTime @default(now())
}

/// AI provider connection configured from Settings. The API key is encrypted at rest.
model AiProvider {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  label           String
  baseUrl         String
  model           String   @default("")
  encryptedApiKey String?
  apiKeyHint      String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

/// Free-text weekly recap written by the user (the daily recap is DailyLog.textSummary).
model WeeklyRecap {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, weekId])
}

/// A course followed by the user (lecture, class, training).
model Course {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String           @default("#8da2fb")
  archived  Boolean          @default(false)
  deadlines CourseDeadline[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, archived])
}

/// An exam, a submission or any important date. Local date and optional local time, like tasks.
model CourseDeadline {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  kind            String   @default("other")
  date            DateTime @db.Date
  time            String?
  durationMinutes Int      @default(60)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@index([courseId])
}
