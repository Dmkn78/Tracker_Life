DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_regime_tracker?schema=public"
APP_ACCESS_KEY="replace-with-a-long-private-access-key"
AUTH_SECRET="replace-with-a-long-random-cookie-signing-secret"
INTERNAL_API_URL="http://127.0.0.1:8000"
ENV="development"
# Optional. Defaults to matching ENV=production. Set to "false" if serving
# production over plain HTTP (no domain/TLS yet) — otherwise browsers drop
# the session cookie and login silently fails.
# COOKIE_SECURE="false"
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
API_HOST="127.0.0.1"
API_PORT="8000"
WHISPER_SERVICE_URL="http://127.0.0.1:8001/transcribe"
MAX_AUDIO_BYTES="26214400"
WHISPER_TIMEOUT_SECONDS="180"
WHISPER_MODEL="tiny"

# Local Parakeet V3: run python scripts/install-parakeet.py once.
# Optional overrides (defaults use .runtime under the repository):
# PARAKEET_MODEL_DIR="/path/to/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8"
# PARAKEET_PYTHON="/path/to/parakeet-venv/bin/python"
