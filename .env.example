DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_regime_tracker?schema=public"
APP_ACCESS_KEY="replace-with-a-long-private-access-key"
AUTH_SECRET="replace-with-a-long-random-cookie-signing-secret"
INTERNAL_API_URL="http://127.0.0.1:8000"
ENV="development"
# Optional. Defaults to matching ENV=production. Set to "false" if serving
# production over plain HTTP (no domain/TLS yet) — otherwise browsers drop
# the session cookie and login silently fails.
# COOKIE_SECURE="false"
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
API_HOST="127.0.0.1"
API_PORT="8000"
WHISPER_SERVICE_URL="http://127.0.0.1:8001/transcribe"
MAX_AUDIO_BYTES="104857600"
WHISPER_TIMEOUT_SECONDS="180"
WHISPER_MODEL="tiny"
# Android updates: private GitHub credentials stay exclusively on the API server.
# Fine-grained token with Contents: read access to this repository only.
MOBILE_GITHUB_REPOSITORY="Dmkn78/Tracker_Life"
MOBILE_GITHUB_TOKEN=""
# Optional local APK publication/cache directory:
# MOBILE_RELEASE_DIR="/opt/interface_API/.runtime/mobile-release"

# Local Parakeet V3: run python scripts/install-parakeet.py once.
# Optional overrides (defaults use .runtime under the repository):
# PARAKEET_MODEL_DIR="/path/to/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8"
# PARAKEET_PYTHON="/path/to/parakeet-venv/bin/python"

# AI providers: API keys typed in Settings are encrypted at rest with this secret.
# Defaults to AUTH_SECRET. Changing it makes stored keys unreadable (re-enter them).
# AI_KEYS_SECRET="replace-with-another-long-random-secret"
# Second brain: Markdown vault (Obsidian-compatible). The app only rewrites
# its own managed blocks under "Tracker/" and never edits your other notes.
# KNOWLEDGE_VAULT_DIR="/home/you/Obsidian/MyVault"
