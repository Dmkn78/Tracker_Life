<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include layout="@layout/notification_quick_tasks" />
    <TextView android:id="@+id/notification_tasks" style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:maxLines="3" android:ellipsize="end" android:textSize="13sp" />
    <TextView android:id="@+id/notification_details" style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:maxLines="3" android:textSize="12sp" />
</LinearLayout>
