# Same PostgreSQL database as the existing Next.js app (Prisma-managed schema).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_regime_tracker?schema=public"

# Must match the values used by the Next.js app so sessions stay compatible.
APP_ACCESS_KEY="replace-with-a-long-private-access-key"
AUTH_SECRET="replace-with-a-long-random-cookie-signing-secret"

# Local Whisper transcription service (services/whisper_service.py).
WHISPER_SERVICE_URL="http://127.0.0.1:8001/transcribe"

# Comma-separated list of frontend origins allowed to call this API with cookies.
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Host/port for the API server.
API_HOST="127.0.0.1"
API_PORT="8000"
